// MorvaneOS default fastfetch look: the Twilight Peaks logo in pastel pink and
// lavender. Your own ~/.config/fastfetch/config.jsonc takes priority over this.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/morvane/fastfetch/logo.txt",
    "color": { "1": "38;2;244;166;198", "2": "38;2;185;163;230" }
  },
  "display": {
    "color": { "keys": "38;2;244;166;198", "title": "38;2;185;163;230" }
  },
  // A config file replaces fastfetch's built-in module list, so it's repeated
  // here: fastfetch's own default (fastfetch --print-structure)
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "de", "wm", "wmtheme", "theme", "icons", "font", "cursor",
    "terminal", "terminalfont", "cpu", "gpu", "memory", "swap", "disk",
    "localip", "battery", "poweradapter", "locale", "break", "colors"
  ]
}
